<?xml version="1.0"?>
<robot name="vehicle_4axle_8wheel_steering">
	<!-- 全局材质定义 -->
	<material name="chassis_gray">
		<color rgba="0.3 0.3 0.3 1.0"/>
	</material>
	<material name="tire_black">
		<color rgba="0.05 0.05 0.05 1.0"/>
	</material>
	<material name="kingpin_silver">
		<color rgba="0.7 0.7 0.7 1.0"/>
	</material>
	
	<!-- 底盘主刚体 base_link 原点整车几何中心 -->
	<link name="base_link">
		<visual>
			<origin xyz="0 0 0.9885" rpy="0 0 0"/>
			<geometry>
				<box size="14.980 2.460 1.977"/>
			</geometry>
			<material name="chassis_gray"/>
		</visual>
		<collision>
			<origin xyz="0 0 0.9885" rpy="0 0 0"/>
			<geometry>
				<box size="14.980 2.460 1.977"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="0 0 0.9885"/>
			<mass value="12000"/>
			<inertia ixx="5000" iyy="12000" izz="13000" ixy="0" ixz="0" iyz="0"/> 
		</inertial>
	</link>
	
	<!-- =================== 第一车桥 x=3.1m 前转向桥 =================== -->
	<link name="axle_1_link"/>
	<joint name="axle_1_joint" type="fixed">
		<parent link="base_link"/>
		<child link="axle_1_link"/>
		<origin xyz="3.100 0 0.700" rpy="0 0 0"/>
	</joint>
	
	<!-- 1桥左主销+转向关节 steer -->
	<link name="axle1_left_kingpin_link">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<cylinder radius="0.08" length="0.700"/>
			</geometry>
			<material name="kingpin_silver"/>
		</visual>
	</link>
	<joint name="axle1_left_steer_joint" type="revolute">
		<parent link="axle_1_link"/>
		<child link="axle1_left_kingpin_link"/>
		<origin xyz="0 1.130 0" rpy="0 0 0"/>
		<axis xyz="0 0 1"/>
		<limit lower="-0.785" upper="0.785" effort="5000" velocity="1.0"/>
	</joint>
	
	<!-- 1桥左轮滚动关节 wheel -->
	<link name="axle1_left_wheel_link">
		<visual>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry>
				<cylinder radius="0.700" length="0.355"/>
			</geometry>
			<material name="tire_black"/>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry>
				<cylinder radius="0.700" length="0.355"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="120"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="25" iyy="40" izz="25" ixy="0" ixz="0" iyz="0"/>
		</inertial>
	</link>
	<joint name="axle1_left_wheel_joint" type="revolute">
		<parent link="axle1_left_kingpin_link"/>
		<child link="axle1_left_wheel_link"/>
		<origin xyz="0 0.3225 0" rpy="0 0 0"/>
		<axis xyz="0 1 0"/>
		<limit lower="-1000" upper="1000" effort="10000" velocity="10.0"/>
	</joint>
	
	<!-- 1桥右主销+转向关节 -->
